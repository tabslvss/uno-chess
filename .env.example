# Copy to .env and fill in from https://supabase.com/dashboard/project/_/settings/api

# Client (Vite)
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key

# Local: leave empty (Vite proxies /socket.io → localhost:3001)
# Production: your Render API URL, e.g. https://unochess-api.onrender.com
VITE_SERVER_URL=

# Production API only (Render) — comma-separated Vercel URLs
# ALLOWED_ORIGINS=https://your-app.vercel.app

# Server only — never expose in the browser
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Optional JWT secret override (defaults to Supabase project JWT secret)
# SUPABASE_JWT_SECRET=

PORT=3001
