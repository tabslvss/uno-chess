# ── Frontend (Vite) ─────────────────────────────────────────────
# Leave the Supabase values empty to run in guest-only mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# PartyKit host for online play (no protocol), e.g. unochess.yourname.partykit.dev
# Leave empty in development — Vite proxies /parties to the local PartyKit server.
VITE_PARTYKIT_HOST=

# ── Game server (PartyKit) ─────────────────────────────────────
# Set these with `npx partykit env add <NAME>` for production, or in a .env
# file next to partykit.json for `partykit dev`.
# SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key   # server only — never expose
# SUPABASE_JWT_SECRET=                              # optional (legacy HS256 projects)
# PARTY_SECRET=some-long-random-string              # matchmaker → game room auth
# ALLOWED_ORIGINS=https://your-site.vercel.app
