{
  "name": "uno-chess",
  "description": "UNO Chess — the cozy mash-up of UNO and chess. Bots, friends, casual & ranked online play.",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n web,party -c magenta,cyan \"vite\" \"partykit dev --port 1999\"",
    "dev:web": "vite",
    "dev:party": "partykit dev --port 1999",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:online": "PARTYKIT_URL=http://127.0.0.1:1999 vitest run party/online.integration.test.ts",
    "test:e2e": "playwright test",
    "party:deploy": "partykit deploy",
    "db:push": "npx supabase db push"
  },
  "devDependencies": {
    "@dicebear/collection": "^9.4.2",
    "@dicebear/core": "^9.4.3",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.104.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.4.0",
    "howler": "^2.2.4",
    "jose": "^6.2.3",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.2",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.19",
    "react": "^19.2.6",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.6",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
