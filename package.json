{
  "name": "uno-chess",
  "description": "UNO Chess — hybrid chess and UNO card game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n web,party -c blue,magenta \"vite\" \"partykit dev\"",
    "dev:web": "vite",
    "dev:party": "partykit dev",
    "party:deploy": "partykit deploy",
    "party:login": "partykit login",
    "server": "tsx server/index.ts",
    "build": "tsc && vite build",
    "start:server": "tsx server/index.ts",
    "preview": "vite preview",
    "supabase:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-supabase.ps1",
    "supabase:link": "supabase link --project-ref ogarlhehzrsthayldrjt",
    "supabase:push": "supabase db push --yes",
    "supabase:sql": "supabase db query --linked --yes",
    "render:setup": "powershell -ExecutionPolicy Bypass -File scripts/setup-render.ps1"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/howler": "^2.2.13",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^29.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.0.12",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-switch": "^1.3.8",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@supabase/supabase-js": "^2.106.0",
    "@tanstack/react-query": "^5.104.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "concurrently": "^9.2.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.39.0",
    "howler": "^2.2.4",
    "jose": "^6.2.3",
    "lucide-react": "^1.52.0",
    "motion": "^14.0.0",
    "nanoid": "^6.0.2",
    "partykit": "^0.0.115",
    "partysocket": "^1.1.19",
    "react": "^19.2.6",
    "react-chessboard": "^5.10.0",
    "react-dom": "^19.2.6",
    "react-router": "^8.4.0",
    "recharts": "^3.10.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  }
}
